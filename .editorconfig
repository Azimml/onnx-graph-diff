# EditorConfig helps keep a consistent coding style across editors and IDEs.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
# Matches the ruff line-length configured in pyproject.toml.
max_line_length = 120

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
